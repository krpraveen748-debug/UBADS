# Copy to .env and adjust as needed. Never hard-code this URL in components —
# always read it via src/api/client.js (import.meta.env.VITE_API_BASE_URL).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production Azure Static Web Apps builds must set this to the deployed
# HTTPS FastAPI App Service origin. Keep the local default for development.
# VITE_API_BASE_URL=https://<api-app-service>.azurewebsites.net
