# Copy this file to config/.env and adjust values as needed.
# .env itself is gitignored — never commit real config/secrets.

APP_NAME=User Behavior Anomaly Detection System
# local | production — production settings require PostgreSQL, private Azure
# Blob model and installer storage, an HTTPS PUBLIC_BASE_URL, and exact HTTPS CORS.
ENVIRONMENT=local

API_HOST=127.0.0.1
API_PORT=8000

# Structured logging level for the backend (see backend/app/core/logging_config.py).
LOG_LEVEL=INFO

STORAGE_BACKEND=local
DATABASE_URL=sqlite:///./data/app.db
# For production, point both backend and event storage at the same PostgreSQL
# database, for example:
# DATABASE_URL=postgresql+psycopg://USERNAME@ubads-postgres-rvce.postgres.database.azure.com:5432/ubads?sslmode=require
# Supply the password through the hosting platform's secret configuration;
# never commit it to this file or source control.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_TIMEOUT_SECONDS=30
# DATABASE_POOL_RECYCLE_SECONDS=1800
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Apply schema changes separately with `alembic upgrade head` before starting
# the API or data-processing commands.

# Isolation Forest model artifacts are local by default. To use Azure Blob,
# provision a private container separately, grant the backend identity access,
# and configure the account URL and container below. Authentication uses
# DefaultAzureCredential; do not put account keys or connection strings here.
MODEL_STORAGE_PROVIDER=local
# ANOMALY_MODEL_DIR=models/anomaly-detection
# MODEL_STORAGE_PROVIDER=azure_blob
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=ubads-models

# The Windows installer is served only by the authenticated backend from a
# private, pre-existing Blob container. The same managed identity accesses it.
INSTALLER_STORAGE_PROVIDER=local
# INSTALLER_STORAGE_PROVIDER=azure_blob
# AZURE_INSTALLER_CONTAINER=ubads-installers
# AZURE_INSTALLER_BLOB_NAME=releases/UBADS-Agent-Setup.exe

# Comma-separated frontend origins allowed to call this API (CORS).
# Local defaults already cover Vite's usual dev ports — override only if
# your frontend runs somewhere else. In production this MUST be set to
# exact HTTPS frontend origin(s); wildcards, paths, and HTTP are rejected.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public HTTPS origin embedded in endpoint enrollment information.
# Required in production; do not derive it from request headers.
# PUBLIC_BASE_URL=https://api.example.com

# Optional trusted reverse-proxy source IPs/CIDRs. Leave empty unless the
# direct proxy ranges are known; forwarded headers are otherwise ignored.
# TRUSTED_PROXIES=10.20.0.0/16,192.0.2.10

# Optional Application Insights connection string. In Azure, supply through
# App Service settings (prefer a Key Vault reference), never commit a value.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Phase 9/10/11: shared ENROLLMENT secret between the backend (validates
# it) and the Windows agent (agent/, presents it as the X-Agent-Api-Key
# header) — used ONLY to enroll a NEW endpoint and issue it its own
# per-agent credential (see backend/app/security/agent_auth.py). Every
# later call (heartbeat, re-registration, ingestion) authenticates with
# that per-agent credential instead, never this key. Leave unset to keep
# enrollment closed (every enrollment attempt rejected) — the safe default
# for local development until you deliberately enroll an agent. Set the
# SAME value here that you configure the agent with.
# AGENT_API_KEY=
# Reserved for a future per-endpoint "stale vs active" status feature —
# defined now as configuration foundation, not yet consumed by any route.
# The existing GET /api/endpoints/status is unchanged and still derives
# its answer from real collected events, not from this setting.
AGENT_STALE_AFTER_SECONDS=300

# --- Windows Endpoint Agent (agent/, Phase 10) ---
# Base URL of the backend the agent talks to.
# BACKEND_URL=http://127.0.0.1:8000
# Optional: override the agent's auto-generated, persisted endpoint_id
# (see agent/identity.py). Leave unset to let the agent generate one.
# ENDPOINT_ID=
# Seconds between collection cycles when running `python agent.py --run`.
# COLLECTION_INTERVAL=60
# Max events collected per category per cycle.
# BATCH_SIZE=50
# Seconds before an agent HTTP request to the backend times out.
# REQUEST_TIMEOUT=10
# Comma-separated log-collector categories the agent collects.
# CATEGORIES=authentication,file_activity,process_activity,device_activity
# Windows Event Log channel the agent reads from.
# LOG_CHANNEL=Security

# Phase 4: optional. If set, file_activity events whose path falls under
# this folder are classified as event_category="download_related"
# (path-based inference only — see log-collector/README.md). Leave unset
# to disable this classification entirely.
# MONITORED_DOWNLOAD_FOLDER=C:\Users\you\Downloads
