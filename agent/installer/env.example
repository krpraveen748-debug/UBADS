# UBADS Windows Endpoint Agent - configuration
#
# Copy this file to ".env" IN THIS SAME FOLDER (next to ubads-agent.exe)
# and edit the values below. No rebuild, reinstall, or code change is
# ever required to change these - the agent reads this file fresh on
# every run. Real Windows environment variables (if set) always take
# priority over this file.
#
# This installer NEVER writes a real BACKEND_URL, AGENT_API_KEY, or any
# other value into this file for you - it only places this EXAMPLE here.
# Nothing is pre-filled with a production secret.

# Base URL of the UBADS backend this agent reports to.
# Use https:// for any backend that is not on your own local machine -
# the agent (via the standard "requests" library) supports HTTPS with
# normal certificate validation out of the box; no extra configuration
# is needed on the agent side once your backend actually serves HTTPS.
BACKEND_URL=http://127.0.0.1:8000

# Shared ENROLLMENT key for this UBADS deployment. It is used ONCE, the
# first time this agent runs, to enroll THIS endpoint and receive its own
# unique, per-agent credential (never shared with any other endpoint).
# After that first successful enrollment, this key is not used again by
# this endpoint - see agent/README.md "Per-agent credential".
#
# LOCAL DEVELOPMENT (this is you, if you built/ran the backend yourself):
# use the exact same AGENT_API_KEY value already set in this project's
# own config/.env at the project root - open that file yourself to see
# it. There is no separate "local dev key" to generate; the agent and the
# backend must simply agree on the same value.
#
# REAL DEPLOYMENT (a separate administrator and installer): ask your
# UBADS administrator for this value out of band. There is no API or CLI
# command that issues or displays it - it is a plain secret an
# administrator sets directly in the backend's config/.env.
AGENT_API_KEY=

# Seconds between collection cycles when running with --run.
COLLECTION_INTERVAL=60

# Max events collected per category per cycle.
BATCH_SIZE=50

# Comma-separated categories to collect. Each requires its own audit
# policy to be enabled by an Administrator first (this installer does
# NOT enable any audit policy - see the "Administrator setup" notice
# shown after installation, and log-collector/README.md for the exact,
# explicit commands).
CATEGORIES=authentication,file_activity,process_activity,device_activity

# Windows Event Log channel to read from.
LOG_CHANNEL=Security

# Agent logging level.
LOG_LEVEL=INFO

# Optional: override this endpoint's auto-generated identity. Leave
# unset unless a UBADS administrator specifically assigned you one.
# ENDPOINT_ID=
